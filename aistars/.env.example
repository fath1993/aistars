# ---------------------------------------------------------------------------
# Bootstrap configuration ONLY. Copy to aistars/.env and fill in.
#
# Everything here must exist before the database does, or is needed to reach
# the database at all. Everything else -- bot token, webhook secret, public
# URL, budgets -- lives in the admin:
#
#     /admin/core/runtimesetting/     credentials and tunables
#     /admin/core/controlpanel/       kill switch, budgets, webhook button
#
# The real .env is committed to the private repo. No '$' in any value: Compose interpolates env_file
# contents, so a '$' followed by a word silently becomes an empty string.
# ---------------------------------------------------------------------------

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=

# Bumped with every change, matching the newest PROJECT_LOG.md entry.
APP_VERSION=0.3.0

# Defaults to False when unset.
DJANGO_DEBUG=False

# Your domain, comma-separated. The floor: PUBLIC_BASE_URL from the admin is
# added on top, never instead.
ALLOWED_HOSTS=
CSRF_TRUSTED_ORIGINS=

# Compose service names on aistars-net.
POSTGRES_HOST=aistars-db
REDIS_HOST=aistars-redis

POSTGRES_DB=aistars
POSTGRES_USER=aistars
POSTGRES_PASSWORD=

PGADMIN_DEFAULT_EMAIL=
PGADMIN_DEFAULT_PASSWORD=

# ---------------------------------------------------------------------------
# Optional fallbacks. Safe to leave blank and set in the admin instead.
# ---------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Spend guard fallback, micro-units of USD (1000000 = 1.00 USD).
# Zero is a HARD STOP; negative disables. The admin value wins when set.
SPEND_DAILY_CAP_MICROS=20000000
SPEND_HOURLY_CAP_MICROS=5000000
